# ==============================================================================
# Infonet Web - .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
desktop.ini
Desktop.ini

# Editor & IDE Files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
.fleet/
.atom/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
*.cert
*.pfx
*.p12

# Node.js & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.pnp.*

# Build Outputs & Bundler Caches
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.output/

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Static Site & Jekyll Build Artifacts
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Temporary & Log Files
*.log
logs/
*.tmp
*.temp
